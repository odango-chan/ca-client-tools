{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtlab:openamsm:mas:v0.4.0:ssm-release-confirm-n2-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ue_identity",
    "psi",
    "release_confirm",
    "release_txn",
    "release_generation"
  ],
  "properties": {
    "ue_identity": {
      "type": "string",
      "pattern": "^imsi-[0-9]{1,15}$"
    },
    "psi": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "release_confirm": {
      "type": "string",
      "const": "n2"
    },
    "release_txn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127
    },
    "release_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10
    }
  }
}
