{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtlab:openamsm:mas:v0.4.0:se-emit-release-event-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ue_identity",
    "psi",
    "ev"
  ],
  "properties": {
    "ue_identity": {
      "type": "string",
      "pattern": "^imsi-[0-9]{1,15}$"
    },
    "psi": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "ev": {
      "type": "string",
      "const": "RELEASED"
    }
  }
}
