{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtlab:openamsm:mas:v0.4.0:upn-modify-qos-delta-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ue_identity",
    "psi",
    "qos_flows_delta",
    "qfi",
    "five_qi",
    "gfbr_ul",
    "gfbr_dl",
    "mfbr_ul",
    "mfbr_dl"
  ],
  "properties": {
    "ue_identity": {
      "type": "string",
      "pattern": "^imsi-[0-9]{1,15}$"
    },
    "psi": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "qos_flows_delta": {
      "type": "string",
      "const": "1"
    },
    "qfi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2
    },
    "five_qi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3
    },
    "gfbr_ul": {
      "type": "string",
      "minLength": 1,
      "maxLength": 13
    },
    "gfbr_dl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 13
    },
    "mfbr_ul": {
      "type": "string",
      "minLength": 1,
      "maxLength": 13
    },
    "mfbr_dl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 13
    }
  }
}
