{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtlab:openamsm:mas:v0.4.0:pa-delete-sm-policy-input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ue_identity",
    "psi",
    "release",
    "trigger"
  ],
  "properties": {
    "ue_identity": {
      "type": "string",
      "pattern": "^imsi-[0-9]{1,15}$"
    },
    "psi": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "release": {
      "type": "string",
      "const": "1"
    },
    "trigger": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    }
  }
}
