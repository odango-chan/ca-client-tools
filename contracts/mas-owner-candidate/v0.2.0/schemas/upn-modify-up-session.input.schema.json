{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:example:openamsm:mas:skill:v0.2.0:upn-modify-up-session-input",
  "required": [
    "ue_identity",
    "psi",
    "anTunnelTeid",
    "anTunnelIp",
    "n4Seid"
  ],
  "properties": {
    "ue_identity": {
      "type": "string",
      "pattern": "^imsi-[0-9]{1,15}$"
    },
    "psi": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "anTunnelTeid": {
      "type": "string",
      "minLength": 1
    },
    "anTunnelIp": {
      "type": "string",
      "minLength": 1
    },
    "n4Seid": {
      "type": "string",
      "minLength": 1
    }
  }
}
