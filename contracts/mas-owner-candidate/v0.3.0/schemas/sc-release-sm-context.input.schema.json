{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "wtlab:openamsm:mas:v0.3.0:sc-release-sm-context-input",
  "required": [
    "ue_identity",
    "psi",
    "release"
  ],
  "properties": {
    "ue_identity": {
      "type": "string",
      "minLength": 1
    },
    "psi": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "release": {
      "type": "string",
      "const": "1"
    }
  }
}
