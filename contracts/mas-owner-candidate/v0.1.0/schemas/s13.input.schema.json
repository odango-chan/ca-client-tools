{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:example:openamsm:mas:s13-input:v1",
  "required": [
    "ue_identity",
    "psi",
    "event",
    "sessionKeys"
  ],
  "properties": {
    "ue_identity": {
      "type": "string",
      "pattern": "^imsi-[0-9]{1,15}$"
    },
    "psi": {
      "type": "integer",
      "minimum": 1,
      "maximum": 15
    },
    "event": {
      "type": "string",
      "const": "ESTABLISHED"
    },
    "sessionKeys": {
      "type": "string",
      "minLength": 1
    }
  }
}
