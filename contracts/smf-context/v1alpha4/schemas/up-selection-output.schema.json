{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-client-tools:smf-context-up-selection-output:v1",
  "title": "SMF up-selection context query output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "status",
    "key",
    "context"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "up-selection"
    },
    "status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supi",
        "pduSessionId"
      ],
      "properties": {
        "supi": {
          "type": "string",
          "minLength": 1
        },
        "pduSessionId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decided": {
          "type": "boolean"
        },
        "upAnchor": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      }
    }
  }
}
