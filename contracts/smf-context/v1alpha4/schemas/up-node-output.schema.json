{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-client-tools:smf-context-up-node-output:v1",
  "title": "SMF up-node context query output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "status",
    "key",
    "context"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "up-node"
    },
    "status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supi",
        "pduSessionId"
      ],
      "properties": {
        "supi": {
          "type": "string",
          "minLength": 1
        },
        "pduSessionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n4Seid": {
          "type": "string"
        },
        "estDone": {
          "type": "boolean"
        },
        "n3Synced": {
          "type": "boolean"
        },
        "dnn": {
          "type": "string"
        },
        "sst": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "sd": {
          "type": "string",
          "maxLength": 6
        },
        "pduSessionType": {
          "type": "string",
          "enum": [
            "IPV4",
            "IPV6",
            "IPV4V6",
            "UNSTRUCTURED",
            "ETHERNET"
          ]
        }
      }
    }
  }
}
