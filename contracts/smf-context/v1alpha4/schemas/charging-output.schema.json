{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:connectionagent:ca-client-tools:smf-context-charging-output:v1",
  "title": "SMF charging context query output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "status",
    "key",
    "context"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "charging"
    },
    "status": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE"
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supi",
        "pduSessionId"
      ],
      "properties": {
        "supi": {
          "type": "string",
          "minLength": 1
        },
        "pduSessionId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bound": {
          "type": "boolean"
        },
        "chargingRef": {
          "type": "string"
        }
      }
    }
  }
}
