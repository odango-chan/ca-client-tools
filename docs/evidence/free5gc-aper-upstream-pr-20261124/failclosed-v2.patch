diff --git a/aper/extension_bit_test.go b/aper/extension_bit_test.go
new file mode 100644
index 0000000..2845674
--- /dev/null
+++ b/aper/extension_bit_test.go
@@ -0,0 +1,34 @@
+package aper
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestReadSequencePreambleBitMapAcceptsExtensionRoot(t *testing.T) {
+	pd := NewPerBitData([]byte{0x00})
+	flags := []bool{}
+	if err := pd.ReadSequencePreambleBitMap(&flags, true); err != nil {
+		t.Fatalf("extension bit 0 must decode: %v", err)
+	}
+}
+
+func TestReadSequencePreambleBitMapRejectsExtensionAdditions(t *testing.T) {
+	pd := NewPerBitData([]byte{0x80})
+	flags := []bool{}
+	err := pd.ReadSequencePreambleBitMap(&flags, true)
+	if err == nil {
+		t.Fatal("extension bit 1 must fail closed")
+	}
+	if !errors.Is(err, ErrExtensibleSequenceUnsupported) {
+		t.Fatalf("unexpected error: %v", err)
+	}
+}
+
+func TestReadSequencePreambleBitMapIgnoresFlagWhenNotExtensible(t *testing.T) {
+	pd := NewPerBitData([]byte{0x00})
+	flags := []bool{}
+	if err := pd.ReadSequencePreambleBitMap(&flags, false); err != nil {
+		t.Fatalf("non-extensible sequence must not read an extension bit: %v", err)
+	}
+}
