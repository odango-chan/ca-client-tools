+// ErrExtensibleSequenceUnsupported is returned when a peer encodes an
+// extensible SEQUENCE with extension additions. This implementation has no
+// representation for the additions, so accepting the value would silently drop
+// data (and would not reproduce the peer's bytes on re-encode).
+var ErrExtensibleSequenceUnsupported = errors.New(
+	"APER extensible SEQUENCE extension additions are not supported")
+
 /*** General bit/byte-operation functions ***/
 func (pd *PerBitData) getSingleBit() (byte, error) {
 	if int(pd.byteOffset) > len(pd.bytes)-1 {
@@ -1089,14 +1096,19 @@ func (pd *PerBitData) ReadSequencePreambleBitMap(dstOptionalPresentFlag *[]bool,
 ) error { // return optional present flag
 	// TO-BE-TEST
 
-	// Case 0.: write extensible bits
+	// Case 0.: read extensible bit
 	if valueExtensible {
-		_, err := pd.ReadExtensible()
+		extensible, err := pd.ReadExtensible()
 		if err != nil {
 			return errors.Wrap(err, "ReadSequencePreambleBitMap()")
 		}
-		// TODO: Support extensible sequence
